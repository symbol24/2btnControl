[internationalization]

locale/translations=PackedStringArray("res://Data/Localization/loc.en.translation", "res://Data/Localization/loc.fr.translation", "res://Data/Localization/loc.fr_CA.translation")

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="parking_spot"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
