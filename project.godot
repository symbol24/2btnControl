; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Valet Parking Not Included"
config/name_localized={
"en": "Valet Parking Not Included",
"fr": "Fais Ton Parking",
"fr_CA": "Stationement Pas Inclut"
}
config/description="With only 2 buttons, can you park all these cars?"
config/version="1.0"
run/main_scene="res://Scenes/UI/boot.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://Textures/key_icon.png"
config/windows_native_icon="res://Textures/icon.ico"

[autoload]

GM="*res://Code/Autoloads/game_manager.gd"
S="*res://Code/Autoloads/signals.gd"
Ui="*res://Scenes/UI/ui_canvas.tscn"
Audio="*res://Code/Autoloads/audio.gd"
PD="*res://Code/Autoloads/player_data.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://Audio/": "blue",
"res://Code/": "yellow",
"res://Data/": "purple",
"res://Scenes/": "red",
"res://Textures/": "green"
}

[global_group]

main_menu=""

[gui]

theme/custom="uid://ccmutdk2gfuxo"

